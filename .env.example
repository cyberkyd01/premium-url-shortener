# ---- Core ----
APP_NAME="Premium URL Shortener"
APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="change-me-to-a-long-random-string"
AUTH_TRUST_HOST=true

# ---- Database (SQLite default; MySQL/Postgres: change provider in prisma/schema.prisma) ----
DATABASE_URL="file:./dev.db"

# ---- Email (SMTP / Mailgun / SendGrid / Postmark / SES / Resend via SMTP) ----
MAIL_FROM="no-reply@example.com"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# ---- Social login ----
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""

# ---- Payments ----
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_MODE="sandbox"

# ---- Captcha ----
RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# ---- AI Copilot ----
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""

# ---- Security ----
GOOGLE_WEBRISK_API_KEY=""
CRON_SECRET="change-me"
